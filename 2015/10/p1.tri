import "trilogy:debug" use dbg
import "trilogy:io" use readline
import "trilogy:string" as str
import "trilogy:core" use repeat, length

func look_and_say s = look 1 s
func look n [c, c, ..rest] = look (n + 1) [c, ..rest]
func look n [c] = say n c
func look n [c, ..rest] = [..say n c, ..look 1 rest]

func say n c = [..str::chars "${n}", c]

proc main!() {
  readline!()
    |> str::chomp
    |> str::chars
    |> repeat 40 look_and_say
    |> length
    |> dbg
}
